# Advanced HTTP Caching Headers and Performance Optimizations
# Generated by Expansion Agent 4

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching with versioning
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML files
    ExpiresByType text/html "access plus 1 hour"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # JSON and XML
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"

    # Manifest
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # HTML files - short cache but allow revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
        Header set Vary "Accept-Encoding"
    </FilesMatch>

    # CSS and JS - long cache with versioning
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, immutable"
        Header set Vary "Accept-Encoding"
    </FilesMatch>

    # Images - long cache
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>

    # Fonts - long cache
    <FilesMatch "\.(woff|woff2|eot|ttf)$">
        Header set Cache-Control "max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Service Worker - no cache
    <FilesMatch "service-worker\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Security headers
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Performance headers
    Header always set Accept-CH "DPR, Viewport-Width, Width"
    Header always set Critical-CH "DPR, Viewport-Width, Width"
</IfModule>

# Enable Keep-Alive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# Optimize ETags
FileETag None

# Enable HTTP/2 Server Push (if supported)
<IfModule mod_http2.c>
    H2PushPriority * after
    H2PushPriority text/css before
    H2PushPriority text/javascript before
    H2PushPriority font/woff2 interleaved
</IfModule>

# Preload critical resources via Link header
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header add Link "</css/critical.css>; rel=preload; as=style"
        Header add Link "</js/main.js>; rel=preload; as=script"
        Header add Link "</fonts/main.woff2>; rel=preload; as=font; type=font/woff2; crossorigin"
    </FilesMatch>
</IfModule>

# Content negotiation for WebP
<IfModule mod_rewrite.c>
    RewriteEngine On

    # WebP support detection and serving
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_URI} \.(jpe?g|png)$
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(.*)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=accept:1]

    # Vary header for WebP
    <IfModule mod_headers.c>
        Header append Vary Accept env=REDIRECT_accept
    </IfModule>
</IfModule>

# Minification rules (if mod_pagespeed is available)
<IfModule pagespeed_module>
    ModPagespeed on
    ModPagespeedEnableFilters rewrite_css,rewrite_javascript
    ModPagespeedEnableFilters combine_css,combine_javascript
    ModPagespeedEnableFilters prioritize_critical_css
    ModPagespeedEnableFilters defer_javascript
    ModPagespeedEnableFilters lazyload_images
    ModPagespeedEnableFilters convert_jpeg_to_webp,convert_png_to_webp
    ModPagespeedEnableFilters remove_comments,collapse_whitespace
</IfModule>

# Advanced security and performance
<IfModule mod_rewrite.c>
    # Prevent access to sensitive files
    RewriteRule ^(.*/)?\.(git|htaccess|htpasswd|env)$ - [F,L]

    # Force HTTPS (uncomment if using SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>