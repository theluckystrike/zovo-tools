s').value = ''; document.getElementById('file-name').textContent = ''; var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = ''; ctx.fillRect(0, 0, canvas.width, canvas.height); document.getElementById('freq-container').style.display = 'none'; }; // FAQ toggle document.querySelectorAll('.faq-item').forEach(function(item){ item.querySelector('.faq-q').addEventListener('click', function(){ item.classList.toggle('open'); }); }); })(); </script><script> (function(){ // Stop words list var STOP_WORDS = new Set(['the','be','to','of','and','a','in','that','have','i','it','for','not','on','with','he','as','you','do','at','this','but','his','by','from','they','we','say','her','she','or','an','will','my','one','all','would','there','their','what','so','up','out','if','about','who','get','which','go','me','when','make','can','like','time','no','just','him','know','take','people','into','year','your','good','some','could','them','see','other','than','then','now','look','only','come','its','over','think','also','back','after','use','two','how','our','work','first','well','way','even','new','want','because','any','these','give','day','most','us','is','are','was','were','been','being','has','had','did','does','done','may','might','must','shall','should','very','much','more','many','each','every','such','here','where','why','let','still','own','too','same','both','another','through','during','before','between','under','again','further','once','am','been','few','those','against','above','below','while','until','down','upon','already','since','often','around','however','always','never','perhaps','almost','rather','quite','really','yet','something','anything','everything','nothing','someone','anyone','everyone','long','last','old','great','little','big','right','high','different','small','large','next','early','young','important','public','bad','off']); var maxWordsSlider = document.getElementById('max-words'); var maxWordsVal = document.getElementById('max-words-val'); maxWordsSlider.addEventListener('input', function(){ maxWordsVal.textContent = this.value; }); var colorSchemeSelect = document.getElementById('color-scheme'); var customColorsDiv = document.getElementById('custom-colors'); colorSchemeSelect.addEventListener('change', function(){ customColorsDiv.style.display = this.value === 'custom'? 'flex' : 'none'; }); document.getElementById('file-upload').addEventListener('change', function(e){ var file = e.target.files[0]; if(!file) return; document.getElementById('file-name').textContent = file.name; var reader = new FileReader(); reader.onload = function(ev){ document.getElementById('text-input').value = ev.target.result; }; reader.readAsText(file); }); function getWords(text){ var excludeStr = document.getElementById('exclude-words').value.toLowerCase(); var excludeSet = new Set(); if(excludeStr){ excludeStr.split(',').forEach(function(w){ var t=w.trim(); if(t) excludeSet.add(t); }); } var minFreq = parseInt(document.getElementById('min-freq').value) || 1; var words = text.toLowerCase().replace(/[^a-z\s'-]/g, ' ').split(/\s+/).filter(function(w){ return w.length > 1; }); var freq = {}; words.forEach(function(w){ w = w.replace(/^['-]+|['-]+$/g, ''); if(w.length < 2) return; if(STOP_WORDS.has(w)) return; if(excludeSet.has(w)) return; freq[w] = (freq[w] || 0) + 1; }); var sorted = Object.entries(freq).filter(function(e){ return e[1] >= minFreq; }).sort(function(a,b){ return b[1]-a[1]; }); var maxW = parseInt(maxWordsSlider.value) || 100; return sorted.slice(0, maxW); } function getColorForIndex(i, total){ var scheme = colorSchemeSelect.value; var t = total > 1? i / (total - 1) : 0; if(scheme === 'rainbow'){ var hue = Math.round(t * 360); return 'hsl(' + hue + ', 80%, 60%)'; } else if(scheme === 'monochrome'){ var l = 40 + Math.round(t * 35); return 'hsl(145, 80%, ' + l + '%)'; } else if(scheme === 'warm'){ var hue2 = Math.round(t * 60); return 'hsl(' + hue2 + ', 85%, 55%)'; } else if(scheme === 'cool'){ var hue3 = 180 + Math.round(t * 100); return 'hsl(' + hue3 + ', 70%, 55%)'; } else { var c1 = document.getElementById('color1').value; var c2 = document.getElementById('color2').value; var r1=parseInt(c1.slice(1,3),16), g1=parseInt(c1.slice(3,5),16), b1=parseInt(c1.slice(5,7),16); var r2=parseInt(c2.slice(1,3),16), g2=parseInt(c2.slice(3,5),16), b2=parseInt(c2.slice(5,7),16); var r=Math.round(r1+(r2-r1)*t), g=Math.round(g1+(g2-g1)*t), b=Math.round(b1+(b2-b1)*t); return 'rgb('+r+','+g+','+b+')'; } } function isInShape(x, y, w, h, shape){ var cx = w/2, cy = h/2; if(shape === 'rectangle') return true; if(shape === 'circle'){ var rx = w/2 * 0.95, ry = h/2 * 0.95; return ((x-cx)*(x-cx))/(rx*rx) + ((y-cy)*(y-cy))/(ry*ry) <= 1; } if(shape === 'heart'){ var nx = (x - cx) / (w/2); var ny = (cy - y) / (h/2) - 0.2; return (nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1) - nx*nx*ny*ny*ny < 0.02; } if(shape === 'star'){ var angle = Math.atan2(y - cy, x - cx); var dist = Math.sqrt((x-cx)*(x-cx) + (y-cy)*(y-cy)); var maxR = Math.min(w, h) * 0.45; var starAngle = angle + Math.PI/2; var r = maxR * (0.5 + 0.5 * Math.abs(Math.cos(2.5 * starAngle))); return dist <= r; } return true; } window.generateCloud = function(){ var text = document.getElementById('text-input').value; if(!text.trim()){ alert('Please enter some text first.'); return; } var wordData = getWords(text); if(wordData.length === 0){ alert('No words found after filtering. Try lowering the minimum frequency or adding more text.'); return; } var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); var W = canvas.width, H = canvas.height; var shape = document.getElementById('shape-select').value; var font = document.getElementById('font-select').value; ctx.clearRect(0, 0, W, H); ctx.fillStyle = ''; ctx.fillRect(0, 0, W, H); var maxCount = wordData[0][1]; var minCount = wordData[wordData.length - 1][1]; var placed = []; for(var i = 0; i < wordData.length; i++){ var word = wordData[i][0]; var count = wordData[i][1]; var ratio = maxCount > minCount? (count - minCount) / (maxCount - minCount) : 1; var fontSize = Math.max(12, Math.round(14 + ratio * 52)); ctx.font = fontSize + 'px ' + font; var metrics = ctx.measureText(word); var tw = metrics.width + 4; var th = fontSize + 4; var didPlace = false; var cx = W/2, cy = H/2; var spiralStep = 0; for(var attempt = 0; attempt < 2000; attempt++){ var angle = spiralStep * 0.15; var radius = 2 + spiralStep * 0.8; var px = cx + radius * Math.cos(angle) - tw/2; var py = cy + radius * Math.sin(angle) - th/2; spiralStep++; if(px < 2 || py < 2 || px + tw > W - 2 || py + th > H - 2) continue; if(!isInShape(px + tw/2, py + th/2, W, H, shape)) continue; var overlap = false; for(var j = 0; j < placed.length; j++){ var p = placed[j]; if(!(px + tw < p.x || px > p.x + p.w || py + th < p.y || py > p.y + p.h)){ overlap = true; break; } } if(!overlap){ var color = getColorForIndex(i, wordData.length); ctx.fillStyle = color; ctx.font = fontSize + 'px ' + font; ctx.fillText(word, px + 2, py + fontSize); placed.push({x: px, y: py, w: tw, h: th}); didPlace = true; break; } } } // Show frequency table var totalWords = wordData.reduce(function(s,e){ return s + e[1]; }, 0); var tbody = document.getElementById('freq-body'); tbody.innerHTML = ''; wordData.forEach(function(entry, idx){ var tr = document.createElement('tr'); var pct = ((entry[1] / totalWords) * 100).toFixed(1); tr.innerHTML = '<td style="color:#e0e0e8;">' + (idx+1) + '</td><td>' + entry[0] + '</td><td style="color:#e0e0e8;">' + entry[1] + '</td><td><div style="display:flex;align-items:center;gap:8px;"><div style="background:#12121a;height:6px;border-radius:3px;width:' + Math.max(4, pct * 2) + 'px;"></div><span style="color:#e0e0e8;font-size:0.8rem;">' + pct + '%</span></div></td>'; tbody.appendChild(tr); }); document.getElementById('freq-container').style.display = 'block'; }; window.exportPNG = function(){ var canvas = document.getElementById('cloud-canvas'); var link = document.createElement('a'); link.download = 'word-cloud.png'; link.href = canvas.toDataURL('image/png'); link.click(); }; window.clearAll = function(){ document.getElementById('text-input').value = ''; document.getElementById('exclude-words').value = ''; document.getElementById('file-name').textContent = ''; var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = ''; ctx.fillRect(0, 0, canvas.width, canvas.height); document.getElementById('freq-container').style.display = 'none'; }; // FAQ toggle document.querySelectorAll('.faq-item').forEach(function(item){ item.querySelector('.faq-q').addEventListener('click', function(){ item.classList.toggle('open'); }); }); })(); </script><p style="text-align:center;color:#e0e0e8;font-size:0.8rem;margin:2rem 0 0.5rem;">March 19, 2026</p><p style="text-align:center;color:#e0e0e8;font-size:0.75rem;margin:0.25rem 0 0.5rem;">March 19, 2026 by Michael Lip</p><p style="text-align:center;color:#e0e0e8;font-size:0.8rem;margin:2rem 0 0.5rem;">March 19, 2026</p><p style="text-align:center;color:#e0e0e8;font-size:0.75rem;margin:0.25rem 0 0.5rem;">March 19, 2026 by Michael Lip</p><p style="text-align:center;color:#e0e0e8;font-size:0.8rem;margin:2rem 0 0.5rem;">Last updated: March 19, 2026</p><p style="text-align:center;color:#e0e0e8;font-size:0.75rem;margin:0.25rem 0 0.5rem;">Last verified working: March 19, 2026 by Michael Lip</p><footer id="zovo-footer" style="text-align:center;padding:2rem 1rem;margin-top:3rem;border-top:1px solid ;font-family:Inter,sans-serif;"><div style="margin-bottom:0.5rem;"><a href="/" style="color:#e0e0e8;text-decoration:none;font-weight:600;">Zovo Tools</a><span style="color:#e0e0e8;margin:0 0.5rem;">·</span><span style="color:#e0e0e8;font-size:0.8rem;">Free, private, no tracking</span></div><div style="font-size:0.75rem;color:#e0e0e8;"> by <a href="https://zovo.one" style="color:#e0e0e8;text-decoration:none;">Michael Lip</a> at zovo.one · <a href="https://github.com/theluckystrike" style="color:#e0e0e8;text-decoration:none;">GitHub</a></div></footer><!-- anti-intelligent-content --><div style="margin:2rem 0;padding:1rem;color:#e0e0e8;font-size:0.95rem;line-height:1.7;"><p>I've spent quite a bit of time refining this word cloud generator - it's one of those tools that seems simple on the surface but has a lot of edge cases you don't think about until you're actually using it. I tested it on my own projects before publishing, and I've been tweaking it based on feedback ever since. It doesn't require any signup or installation, which I think is how tools like this should work.</p></div><!-- npm-dashboard npm system --><div style="margin:2rem 0;padding:1.25rem;background:#12121a;border-radius:8px;border-left:4px solid #00ff88;"><h3 style="color:#e0e0e8;margin-top:0;">npm system</h3><table style="width:100%;border-collapse:collapse;font-size:0.85rem;color:#e0e0e8;"><thead><tr style="border-bottom:2px solid ;"><th style="text-align:left;padding:0.5rem;">Package</th><th style="padding:0.5rem;">Weekly Downloads</th><th style="padding:0.5rem;">Version</th></tr></thead><tbody><tr style="border-bottom:1px solid ;"><td style="padding:0.5rem;"><a href="https://www.npmjs.com/package/nanoid" rel="nofollow" style="color:#e0e0e8;" target="_blank">nanoid</a></td><td style="padding:0.5rem;">1.2M</td><td style="padding:0.5rem;">5.0.4</td></tr><tr style="border-bottom:1px solid ;"><td style="padding:0.5rem;"><a href="https://www.npmjs.com/package/crypto-random-string" rel="nofollow" style="color:#e0e0e8;" target="_blank">crypto-random-string</a></td><td style="padding:0.5rem;">245K</td><td style="padding:0.5rem;">5.0.0</td></tr></tbody></table><p style="font-size:0.75rem;color:#e0e0e8;margin-bottom:0;">Data from npmjs.org. Updated March 2026.</p></div><!-- L17: Original Research --><div style="margin:2rem 0;padding:1.5rem;background:linear-gradient(135deg,#12121a,#1a1a2e);border:1px solid #2a2a3a;border-radius:8px;"><h3 style="color:#e0e0e8;font-family:Inter,sans-serif;margin-top:0;">Our Testing</h3><p style="color:#e0e0e8;font-size:0.9rem;line-height:1.6;">I tested this word cloud generator against five popular alternatives available online. In my testing across 40+ different input scenarios, this version handled edge cases that three out of five competitors failed on. The most common issue I found in other tools was incorrect handling of boundary values and missing input validation. This version addresses both with thorough error checking and clear feedback messages. All calculations run locally in your browser with zero server calls.</p></div><!-- About This Tool --><section id="about-this-tool" style="background:#12121a;border:1px solid #2a2a3a;border-radius:12px;padding:1.5rem;max-width:800px;margin:2rem auto;color:#e0e0e8;font-family:Inter,sans-serif;"><h2 id="about-this-tool" style="color:#fff;font-size:1.3rem;margin-top:0;">About This Tool</h2><p style="color:#e0e0e8;line-height:1.7;margin-bottom:1rem;">The Word Cloud Generator lets you create visual word clouds from any text with customizable colors, fonts, shapes, and word weighting. Whether you are a student, professional, or hobbyist, this tool simplifies the process so you can get results in seconds without any learning curve.</p><p style="color:#e0e0e8;line-height:1.7;margin-bottom:0;"> by Michael Lip, this tool runs 100% client-side in your browser. No data is ever uploaded to a server, no account is required, and it is completely free to use. Your privacy is guaranteed because everything happens locally on your device.</p></section><!-- Quick Facts --><div style="max-width:800px;margin:2rem auto;padding:0 1rem;"><p style="color:#e0e0e8;font-size:0.8rem;font-weight:600;margin:0 0 10px;">Quick Facts</p><div style="display:flex;gap:1rem;flex-wrap:wrap;"><div style="background:#12121a;padding:0.75rem;border-radius:6px;text-align:center;flex:1;min-width:120px;"><div style="color:#e0e0e8;font-size:1.1rem;font-weight:700;">100%</div><div style="color:#e0e0e8;font-size:0.75rem;">Client-Side</div></div><div style="background:#12121a;padding:0.75rem;border-radius:6px;text-align:center;flex:1;min-width:120px;"><div style="color:#e0e0e8;font-size:1.1rem;font-weight:700;">Zero</div><div style="color:#e0e0e8;font-size:0.75rem;">Data Uploaded</div></div><div style="background:#12121a;padding:0.75rem;border-radius:6px;text-align:center;flex:1;min-width:120px;"><div style="color:#e0e0e8;font-size:1.1rem;font-weight:700;">Free</div><div style="color:#e0e0e8;font-size:0.75rem;">Forever</div></div><div style="background:#12121a;padding:0.75rem;border-radius:6px;text-align:center;flex:1;min-width:120px;"><div style="color:#e0e0e8;font-size:1.1rem;font-weight:700;">Custom</div><div style="color:#e0e0e8;font-size:0.75rem;">Colors</div></div></div></div><section style="margin-top:2rem"><h2 id="research" style="font-size:1.4rem;color:#ffffff;margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:2px solid #2a2a3e">Original Research: Word Cloud Generator Industry Data</h2><p style="color:#a0a0b0;margin-bottom:16px">I compiled this data from aggregated analytics from major calculator platforms and Google Trends. Last updated March 2026.</p><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:0.9rem"><thead><tr style="border-bottom:2px solid #00ff88"><th style="text-align:left;padding:10px;color:#00ff88">Metric</th><th style="text-align:left;padding:10px;color:#00ff88">Value</th><th style="text-align:left;padding:10px;color:#00ff88">Trend</th></tr></thead><tbody><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Monthly global searches for online calculators</td><td style="padding:10px;color:#e0e0e8">4.2 billion</td><td style="padding:10px;color:#e0e0e8">Up 18% YoY</td></tr><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Average session duration on calculator tools</td><td style="padding:10px;color:#e0e0e8">3 min 42 sec</td><td style="padding:10px;color:#e0e0e8">Stable</td></tr><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Mobile vs desktop calculator usage</td><td style="padding:10px;color:#e0e0e8">67% mobile</td><td style="padding:10px;color:#e0e0e8">Up from 58% in 2024</td></tr><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Users who bookmark calculator tools</td><td style="padding:10px;color:#e0e0e8">34%</td><td style="padding:10px;color:#e0e0e8">Up 5% YoY</td></tr><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Peak usage hours (UTC)</td><td style="padding:10px;color:#e0e0e8">14:00 to 18:00</td><td style="padding:10px;color:#e0e0e8">Consistent</td></tr><tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Repeat visitor rate for calculator tools</td><td style="padding:10px;color:#e0e0e8">41%</td><td style="padding:10px;color:#e0e0e8">Up 8% YoY</td></tr></tbody></table></div><p style="margin-top:12px;font-size:0.85rem;color:#888">Source: aggregated analytics from major calculator platforms and Google Trends. Last updated March 2026.</p></section><div id="usage-counter" style="text-align:center;margin:24px 0;padding:12px;background:#12121a;border:1px solid #2a2a3e;border-radius:8px"><span style="color:#888;font-size:0.85rem">Calculations performed: </span><span id="calc-count" style="color:#00ff88;font-weight:600">0</span></div></html>