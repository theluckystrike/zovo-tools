= wordData.reduce(function(s,e){ return s + e[1]; }, 0); var tbody = document.getElementById('freq-body'); tbody.innerHTML = ''; wordData.forEach(function(entry, idx){ var tr = document.createElement('tr'); var pct = ((entry[1] / totalWords) * 100).toFixed(1); tr.innerHTML = '<td style="color:#e0e0e8;">' + (idx+1) + '</td><td>' + entry[0] + '</td><td style="color:#e0e0e8;">' + entry[1] + '</td><td><div style="display:flex;align-items:center;gap:8px;"><div style="background:#12121a;height:6px;border-radius:3px;width:' + Math.max(4, pct * 2) + 'px;"></div><span style="color:#e0e0e8;font-size:0.8rem;">' + pct + '%</span></div></td>'; tbody.appendChild(tr); }); document.getElementById('freq-container').style.display = 'block'; }; window.exportPNG = function(){ var canvas = document.getElementById('cloud-canvas'); var link = document.createElement('a'); link.download = 'word-cloud.png'; link.href = canvas.toDataURL('image/png'); link.click(); }; window.clearAll = function(){ document.getElementById('text-input').value = ''; document.getElementById('exclude-words').value = ''; document.getElementById('file-name').textContent = ''; var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = ''; ctx.fillRect(0, 0, canvas.width, canvas.height); document.getElementById('freq-container').style.display = 'none'; }; // FAQ toggle document.querySelectorAll('.faq-item').forEach(function(item){ item.querySelector('.faq-q').addEventListener('click', function(){ item.classList.toggle('open'); }); }); })(); </script><script> (function(){ // Stop words list var STOP_WORDS = new Set(['the','be','to','of','and','a','in','that','have','i','it','for','not','on','with','he','as','you','do','at','this','but','his','by','from','they','we','say','her','she','or','an','will','my','one','all','would','there','their','what','so','up','out','if','about','who','get','which','go','me','when','make','can','