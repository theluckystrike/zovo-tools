slice(3,5),16), b2=parseInt(c2.slice(5,7),16); var r=Math.round(r1+(r2-r1)*t), g=Math.round(g1+(g2-g1)*t), b=Math.round(b1+(b2-b1)*t); return 'rgb('+r+','+g+','+b+')'; } } function isInShape(x, y, w, h, shape){ var cx = w/2, cy = h/2; if(shape === 'rectangle') return true; if(shape === 'circle'){ var rx = w/2 * 0.95, ry = h/2 * 0.95; return ((x-cx)*(x-cx))/(rx*rx) + ((y-cy)*(y-cy))/(ry*ry) <= 1; } if(shape === 'heart'){ var nx = (x - cx) / (w/2); var ny = (cy - y) / (h/2) - 0.2; return (nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1) - nx*nx*ny*ny*ny < 0.02; } if(shape === 'star'){ var angle = Math.atan2(y - cy, x - cx); var dist = Math.sqrt((x-cx)*(x-cx) + (y-cy)*(y-cy)); var maxR = Math.min(w, h) * 0.45; var starAngle = angle + Math.PI/2; var r = maxR * (0.5 + 0.5 * Math.abs(Math.cos(2.5 * starAngle))); return dist <= r; } return true; } window.generateCloud = function(){ var text = document.getElementById('text-input').value; if(!text.trim()){ alert('Please enter some text first.'); return; } var wordData = getWords(text); if(wordData.length === 0){ alert('No words found after filtering. Try lowering the minimum frequency or adding more text.'); return; } var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); var W = canvas.width, H = canvas.height; var shape = document.getElementById('shape-select').value; var font = document.getElementById('font-select').value; ctx.clearRect(0, 0, W, H); ctx.fillStyle = ''; ctx.fillRect(0, 0, W, H); var maxCount = wordData[0][1]; var minCount = wordData[wordData.length - 1][1]; var placed = []; for(var i = 0; i < wordData.length; i++){ var word = wordData[i][0]; var count = wordData[i][1]; var ratio = maxCount > minCount? (count - minCount) / (maxCount - minCount) : 1; var fontSize = Math.max(12, Math.round(14 + ratio * 52)); ctx.font = fontSize + 'px ' + font; var metrics = ctx.measureText(word); var tw = metrics.width + 4; var th = fontSize + 4; var didPlace = false; var cx = W/2, cy = H/2; var spiralStep = 0; for(var attempt = 0; attempt < 2000; attempt++){ var angle = spiralStep * 0.15; var radius = 2 + spiralStep * 0.8; var px = cx + radius * Math.cos(angle) - tw/2; var py = cy + radius * Math.sin(angle) - th/2; spiralStep++; if(px < 2 || py < 2 || px + tw > W - 2 || py + th > H - 2) continue; if(!isInShape(px + tw/2, py + th/2, W, H, shape)) continue; var overlap = false; for(var j = 0; j < placed.length; j++){ var p = placed[j]; if(!(px + tw < p.x || px > p.x + p.w || py + th < p.y || py > p.y + p.h)){ overlap = true; break; } } if(!overlap){ var color = getColorForIndex(i, wordData.length); ctx.fillStyle = color; ctx.font = fontSize + 'px ' + font; ctx.fillText(word, px + 2, py + fontSize); placed.push({x: px, y: py, w: tw, h: th}); didPlace = true; break; } } } // Show frequency table var totalWords = wordData.reduce(function(s,e){ return s + e[1]; }, 0); var tbody = document.getElementById('freq-body'); tbody.innerHTML = ''; wordData.forEach(function(entry, idx){ var tr = document.createElement('tr'); var pct = ((entry[1] / totalWords) * 100).toFixed(1); tr.innerHTML = '<td style="color:#e0e0e8;">' + (idx+1) + '</td><td>' + entry[0] + '</td><td style="color:#e0e0e8;">' + entry[1] + '</td><td><div style="display:flex;align-items:center;gap:8px;"><div style="background:#12121a;height:6px;border-radius:3px;width:' + Math.max(4, pct * 2) + 'px;"></div><span style="color:#e0e0e8;font-size:0.8rem;">' + pct + '%</span></div></td>'; tbody.appendChild(tr); }); document.getElementById('freq-container').style.display = 'block'; }; window.exportPNG = function(){ var canvas = document.getElementById('cloud-canvas'); var link = document.createElement('a'); link.download = 'word-cloud.png'; link.href = canvas.toDataURL('image/png'); link.click(); }; window.clearAll = function(){ document.getElementById('text-input').value = ''; document.getElementById('exclude-words').value = ''; document.getElementById('file-name').textContent = ''; var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = ''; ctx.fillRect(0, 0, canvas.width, canvas.height); document.getElementById('freq-container').style.display = 'none'; }; // FAQ toggle document.querySelectorAll('.faq-item').forEach(function(item){ item.querySelector('.faq-q').addEventListener('click', function(){ item.classList.toggle('open'); }); }); })(); </script><script> (function(){ // Stop words list var STOP_WORDS = new Set(['the','be','to','of','and','a','in','that','have','i','it','for','not','on','with','he','as','you','do','at','this','but','his','by','from','they','we','say','her','she','or','an','will','my','one','all','would','there','their','what','so','up','out','if','about','who','get','which','go','me','when','make','can','like','time','no','just','him','know','take','people','into','year','your','good','some','could','them','see','other','than','then','now','look','only','come','its','over','think','also','back','after','use','two','how','our','work','first','well','way','even','new','want','because','any','these','give','day','most','us','is','are','was','were','been','being','has','had','did','does','done','may','might','must','shall','should','very','much','more','many','each','every','such','here','where','why','let','still','own','too','same','both','another','through','during','before','between','under','again','further','once','am','been','few','those','against','above','below','while','until','down','upon','already','since','often','around','however','always','never','perhaps','almost','rather','quite','really','yet','something','anything','everything','nothing','someone','anyone','everyone','long','last','old','great','little','big','right','high','different','small','large','next','early','young','important','public','bad','off']); var maxWordsSlider = document.getElementById('max-words'); var maxWordsVal = document.getElementById('max-words-val');