lse if(scheme === 'cool'){ var hue3 = 180 + Math.round(t * 100); return 'hsl(' + hue3 + ', 70%, 55%)'; } else { var c1 = document.getElementById('color1').value; var c2 = document.getElementById('color2').value; var r1=parseInt(c1.slice(1,3),16), g1=parseInt(c1.slice(3,5),16), b1=parseInt(c1.slice(5,7),16); var r2=parseInt(c2.slice(1,3),16), g2=parseInt(c2.slice(3,5),16), b2=parseInt(c2.slice(5,7),16); var r=Math.round(r1+(r2-r1)*t), g=Math.round(g1+(g2-g1)*t), b=Math.round(b1+(b2-b1)*t); return 'rgb('+r+','+g+','+b+')'; } } function isInShape(x, y, w, h, shape){ var cx = w/2, cy = h/2; if(shape === 'rectangle') return true; if(shape === 'circle'){ var rx = w/2 * 0.95, ry = h/2 * 0.95; return ((x-cx)*(x-cx))/(rx*rx) + ((y-cy)*(y-cy))/(ry*ry) <= 1; } if(shape === 'heart'){ var nx = (x - cx) / (w/2); var ny = (cy - y) / (h/2) - 0.2; return (nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1) - nx*nx*ny*ny*ny < 0.02; } if(shape === 'star'){ var angle = Math.atan2(y - cy, x - cx); var dist = Math.sqrt((x-cx)*(x-cx) + (y-cy)*(y-cy)); var maxR = Math.min(w, h) * 0.45; var starAngle = angle + Math.PI/2; var r = maxR * (0.5 + 0.5 * Math.abs(Math.cos(2.5 * starAngle))); return dist <= r; } return true; } window.generateCloud = function(){ var text = document.getElementById('text-input').value; if(!text.trim()){ alert('Please enter some text first.'); return; } var wordData = getWords(text); if(wordData.length === 0){ alert('No words found after filtering. Try lowering the minimum frequency or adding more text.'); return; } var canvas = document.getElementById('cloud-canvas'); var ctx = canvas.getContext('2d'); var W = canvas.width, H = canvas.height; var shape = document.getElementById('shape-select').value; var font = document.getElementById('font-select').value; ctx.clearRect(0, 0, W, H); ctx.fillStyle = ''; ctx.fillRect(0, 0, W, H); var maxCount = wordData[0][1]; var minCount = wordData[wordData.length - 1][1]; var placed = []; for(var i = 0; i < wordData.length; i