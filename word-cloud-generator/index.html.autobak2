ould','them','see','other','than','then','now','look','only','come','its','over','think','also','back','after','use','two','how','our','work','first','well','way','even','new','want','because','any','these','give','day','most','us','is','are','was','were','been','being','has','had','did','does','done','may','might','must','shall','should','very','much','more','many','each','every','such','here','where','why','let','still','own','too','same','both','another','through','during','before','between','under','again','further','once','am','been','few','those','against','above','below','while','until','down','upon','already','since','often','around','however','always','never','perhaps','almost','rather','quite','really','yet','something','anything','everything','nothing','someone','anyone','everyone','long','last','old','great','little','big','right','high','different','small','large','next','early','young','important','public','bad','off']); var maxWordsSlider = document.getElementById('max-words'); var maxWordsVal = document.getElementById('max-words-val'); maxWordsSlider.addEventListener('input', function(){ maxWordsVal.textContent = this.value; }); var colorSchemeSelect = document.getElementById('color-scheme'); var customColorsDiv = document.getElementById('custom-colors'); colorSchemeSelect.addEventListener('change', function(){ customColorsDiv.style.display = this.value === 'custom'? 'flex' : 'none'; }); document.getElementById('file-upload').addEventListener('change', function(e){ var file = e.target.files[0]; if(!file) return; document.getElementById('file-name').textContent = file.name; var reader = new FileReader(); reader.onload = function(ev){ document.getElementById('text-input').value = ev.target.result; }; reader.readAsText(file); }); function getWords(text){ var excludeStr = document.getElementById('exclude-words').value.toLowerCase(); var excludeSet = new Set(); if(excludeStr){ excludeStr.split(',').forEach(function(w){ var t=w.trim(); if(t) excludeSet.add(t); }); } var minFreq = parseInt(document.getElementById('min-freq').value) || 1; var words = text.toLowerCase().replace(/[^a-z\s'-]/g, ' ').split(/\s+/).filter(function(w){ return w.length > 1; }); var freq = {}; words.forEach(function(w){ w = w.replace(/^['-]+|['-]+$/g, ''); if(w.length < 2) return; if(STOP_WORDS.has(w)) return; if(excludeSet.has(w)) return; freq[w] = (freq[w] || 0) + 1; }); var sorted = Object.entries(freq).filter(function(e){ return e[1] >= minFreq; }).sort(function(a,b){ return b[1]-a[1]; }); var maxW = parseInt(maxWordsSlider.value) || 100; return sorted.slice(0, maxW); } function getColorForIndex(i, total){ var scheme = colorSchemeSelect.value; var t = total > 1? i / (total - 1) : 0; if(scheme === 'rainbow'){ var hue = Math.round(t * 360); return 'hsl(' + hue + ', 80%, 60%)'; } else if(scheme === 'monochrome'){ var l = 40 + Math.round(t * 35); return 'hsl(145, 80%, ' + l + '%)'; } else if(scheme === 'warm'){ var hue2 = Math.round(t * 60); return 'hsl(' + hue2 + ', 85%, 55%)'; } else if(scheme === 'cool'){ var hue3 = 180 + Math.round(t * 100); return 'hsl(' + hue3 + ', 70%, 55%)'; } else { var c1 = document.getElementById('color1').value; var c2 = document.getElementById('color2').value; var r1=parseInt(c1.slice(1,3),16), g1=parseInt(c1.slice(3,5),16), b1=parseInt(c1.slice(5,7),16); var r2=parseInt(c2.slice(1,3),16), g2=parseInt(c2.slice(3,5),16), b2=parseInt(c2.slice(5,7),16); var r=Math.round(r1+(r2-r1)*t), g=Math.round(g1+(g2-g1)*t), b=Math.round(b1+(b2-b1)*t); return 'rgb('+r+','+g+','+b+')'; } } function isInShape(x, y, w, h, shape){ var cx = w/2, cy = h/2; if(shape === 'rectangle') return true; if(shape === 'circle'){ var rx = w/2 * 0.95, ry = h/2 * 0.95; return ((x-cx)*(x-cx))/(rx*rx) + ((y-cy)*(y-cy))/(ry*ry) <= 1; } if(shape === 'heart'){ var nx = (x - cx) / (w/2); var ny = (cy - y) / (h/2) - 0.2; return (nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1)*(nx*nx + ny*ny - 1) - nx*nx*ny*ny*ny < 0.02; } if(shape === 'star'){ var angle = Math.atan2