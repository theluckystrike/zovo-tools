<tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Texas</td><td style="padding:10px;color:#e0e0e8">$0</td><td style="padding:10px;color:#e0e0e8">$80,464</td><td style="padding:10px;color:#e0e0e8">+$120</td></tr>
<tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Florida</td><td style="padding:10px;color:#e0e0e8">$0</td><td style="padding:10px;color:#e0e0e8">$80,464</td><td style="padding:10px;color:#e0e0e8">+$120</td></tr>
<tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">Oregon</td><td style="padding:10px;color:#e0e0e8">$7,200</td><td style="padding:10px;color:#e0e0e8">$73,264</td><td style="padding:10px;color:#e0e0e8">-$7,080</td></tr>
<tr style="border-bottom:1px solid #2a2a3e"><td style="padding:10px;color:#e0e0e8">California</td><td style="padding:10px;color:#e0e0e8">$5,800</td><td style="padding:10px;color:#e0e0e8">$74,664</td><td style="padding:10px;color:#e0e0e8">-$5,680</td></tr>
