<div class="video-learn" style="max-width:700px;margin:1.5rem auto;padding:16px 20px;background:#12121a;border-left:4px solid #ff0000;border-radius:0 8px 8px 0;"><p style="margin:0 0 8px;font-size:0.7rem;color:#ff4444;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Video Tutorials</p><a href="https://www.youtube.com/results?search_query=washington+payroll+tax+calculation" rel="noopener" style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:#1a1a26;border-radius:8px;text-decoration:none;transition:background 0.2s;" target="_blank"><svg fill="#ff0000" height="36" viewBox="0 0 24 24" width="36"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.9 31.9 0 0 0 0 12a31.9 31.9 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8z"/><polygon fill="#fff" points="9.75,15.02 15.5,12 9.75,8.98"/></svg><div><p style="margin:0;color:#e0e0e8;font-size:0.9rem;font-weight:500;">Watch Washington Payroll Calculator tutorials on YouTube</p><p style="margin:2px 0 0;color:#8888a0;font-size:0.75rem;">Learn with free video guides and walkthroughs</p></div></a></div>
<section style="margin-top:2rem">
<h2 style="font-size:1.5rem;color:#ffffff;margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:2px solid #2a2a3e">Washington State Tax Overview</h2>
<p style="color:#b0b0b8;line-height:1.8;margin-bottom:1rem">Washington is one of nine states with no personal income tax, which means your paycheck avoids state-level withholding entirely. However, businesses operating in Washington are subject to the Business and Occupation (B&amp;O) tax, a gross receipts tax that varies by industry classification. Employers must also fund workers' compensation premiums through the Department of Labor and Industries, with rates that differ by risk class and claims history.</p>
</section>
<footer style="text-align:center;padding:24px;color:#e0e0e8;font-size:0.85rem;border-top:1px solid ;margin-top:40px;">Built by Michael Lip · More free tools at <a href="https://zovo.one/free-tools/" style="color:#e0e0e8;text-decoration:none;">zovo.one</a></footer>
</div>
<script>
function calculatePayroll(){var gross=parseFloat(document.getElementById('grossSalary').value)||0;var freq=parseInt(document.getElementById('payFrequency').value)||26;var status=document.getElementById('filingStatus').value;var waCaresExempt=document.getElementById('waCares').value==='yes';var k401=parseFloat(document.getElementById('preTax401k').value)||0;var otherDed=parseFloat(document.getElementById('otherDeductions').value)||0;var preTaxTotal=(gross*k401/100)+otherDed;var taxableGross=Math.max(0,gross-preTaxTotal);var fedStdDed=status==='married'?30000:status==='head'?22500:15000;var fedTaxable=Math.max(0,taxableGross-fedStdDed);var fedTax=0;if(status==='married'){var mb=[23850,96950,206700,394600,501050,751600,Infinity];var mr=[0.10,0.12,0.22,0.24,0.32,0.35,0.37];var prev=0;for(var i=0;i<mb.length;i++){var amt=Math.min(fedTaxable,mb[i])-prev;if(amt>0)fedTax+=amt*mr[i];prev=mb[i];if(fedTaxable<=mb[i])break;}}else if(status==='head'){var hb=[17000,64850,103350,197300,250500,626350,Infinity];var hr=[0.10,0.12,0.22,0.24,0.32,0.35,0.37];var prev=0;for(var i=0;i<hb.length;i++){var amt=Math.min(fedTaxable,hb[i])-prev;if(amt>0)fedTax+=amt*hr[i];prev=hb[i];if(fedTaxable<=hb[i])break;}}else{var sb=[11925,48475,103350,197300,250525,626350,Infinity];var sr=[0.10,0.12,0.22,0.24,0.32,0.35,0.37];var prev=0;for(var i=0;i<sb.length;i++){var amt=Math.min(fedTaxable,sb[i])-prev;if(amt>0)fedTax+=amt*sr[i];prev=sb[i];if(fedTaxable<=sb[i])break;}}var stateTax=0;var ssWage=Math.min(taxableGross,176100);var ssTax=ssWage*0.062;var medicareTax=taxableGross*0.0145;if(taxableGross>200000)medicareTax+=(taxableGross-200000)*0.009;var waCaresTax=waCaresExempt?0:gross*0.0058;var pfmlTax=gross*0.005388;var totalDeductions=fedTax+stateTax+ssTax+medicareTax+waCaresTax+pfmlTax;var netPay=taxableGross-fedTax-stateTax-ssTax-medicareTax-waCaresTax-pfmlTax;var perPeriod=netPay/freq;var effectiveRate=gross>0?(totalDeductions/gross*100):0;function fmt(n){return'$'+Math.round(n).toLocaleString('en-US');}document.getElementById('rGross').textContent=fmt(gross);document.getElementById('rPreTax').textContent='-'+fmt(preTaxTotal);document.getElementById('rFederal').textContent='-'+fmt(fedTax);document.getElementById('rState').textContent='$0 (no state income tax)';document.getElementById('rSS').textContent='-'+fmt(ssTax);document.getElementById('rMedicare').textContent='-'+fmt(medicareTax);document.getElementById('rWACares').textContent=waCaresExempt?'$0 (exempt)':'-'+fmt(waCaresTax);document.getElementById('rPFML').textContent='-'+fmt(pfmlTax);document.getElementById('rNet').textContent=fmt(netPay);document.getElementById('rPeriod').textContent=fmt(perPeriod);document.getElementById('rRate').textContent=effectiveRate.toFixed(1)+'%';document.getElementById('results').style.display='block';var items=[{label:'Take-Home',value:netPay,color:''},{label:'Federal Tax',value:fedTax,color:''},{label:'Social Security',value:ssTax,color:''},{label:'Medicare',value:medicareTax,color:''},{label:'WA Cares',value:waCaresTax,color:''},{label:'PFML',value:pfmlTax,color:''},{label:'Pre-Tax Ded.',value:preTaxTotal,color:''}];var maxVal=Math.max.apply(null,items.map(function(x){return x.value;}));var chartHtml='<h3 style="margin-bottom:16px;color:#e0e0e8;">Paycheck Breakdown</h3>';for(var i=0;i<items.length;i++){var pct=maxVal>0?(items[i].value/maxVal*100):0;chartHtml+='<div class="bar-row"><span class="bar-label">'+items[i].label+'</span><div style="flex:1;background:#12121a;border-radius:4px;overflow:hidden;"><div class="bar-fill" style="width:'+pct+'%;background:'+items[i].color+';"></div></div><span class="bar-value">'+fmt(items[i].value)+'</span></div>';}var bc=document.getElementById('barChart');bc.innerHTML=chartHtml;bc.style.display='block';}
document.addEventListener('DOMContentLoaded',function(){calculatePayroll();});
</script>
