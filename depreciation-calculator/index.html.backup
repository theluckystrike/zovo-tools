</script><style>
/* 🎨 VIRTUOSO AESTHETIC MASTERY SYSTEM 🎨 */
/* Renaissance Master-Level Design Excellence with Golden Ratio Precision */

:root {
    /* Golden Ratio Based Spacing System */
    --space-xs: 4.9px;
    --space-sm: 8px;
    --space-md: 12.9px;
    --space-lg: 20.9px;
    --space-xl: 33.9px;
    --space-xxl: 54.8px;

    /* Golden Ratio Typography Scale */
    --font-xs: 9.9px;
    --font-sm: 16px;
    --font-md: 25.9px;
    --font-lg: 41.9px;
    --font-xl: 67.8px;

    /* Renaissance Master Color Palette */
    --primary: #1a0d33;
    --surface: #2a1a4a;
    --surface-light: #3d2961;
    --border: #4a3478;
    --border-hover: #5c428f;
    --text-primary: #f8f6ff;
    --text-secondary: #d4c8f0;
    --text-muted: #a690d1;
    --accent-gold: #d4af37;
    --accent-emerald: #00d4aa;
    --accent-gradient: linear-gradient(135deg, #d4af37 0%, #00d4aa 100%);
    --shadow-soft: rgba(26, 13, 51, 0.15);
    --shadow-medium: rgba(26, 13, 51, 0.25);
    --shadow-deep: rgba(26, 13, 51, 0.4);
    --glow-gold: rgba(212, 175, 55, 0.2);
    --glow-emerald: rgba(0, 212, 170, 0.15);

    /* Golden Ratio Proportions */
    --golden-ratio: 1.618033988749;
    --golden-width: 61.8%;
    --golden-complement: 38.2%;
    --border-radius: calc(var(--space-sm) * var(--golden-ratio));
    --border-radius-lg: calc(var(--space-md) * var(--golden-ratio));
}

/* ✨ VIRTUOSO BASE STYLES ✨ */
*,*::before,*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(135deg, var(--primary) 0%, #0f051a 100%);
    color: var(--text-primary);
    line-height: var(--golden-ratio);
    min-height: 100vh;
    font-size: var(--font-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* 🏛️ ARCHITECTURAL LAYOUT WITH GOLDEN PROPORTIONS 🏛️ */
.container {
    max-width: min(1200px, 90vw);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    position: relative;
}

.container::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 20% 50%, rgba(212, 175, 55, 0.03) 0%, transparent 70%),
                radial-gradient(ellipse at 80% 20%, rgba(0, 212, 170, 0.02) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
}

/* 🎭 MASTERPIECE TYPOGRAPHY HIERARCHY 🎭 */
h1 {
    font-size: clamp(var(--font-lg), 5vw, var(--font-xl));
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: calc(1 / var(--golden-ratio));
    margin-bottom: var(--space-lg);
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 30px var(--glow-gold);
    position: relative;
}

h1::after {
    content: '';
    position: absolute;
    bottom: calc(-1 * var(--space-sm));
    left: 0;
    width: var(--golden-width);
    height: 2px;
    background: var(--accent-gradient);
    border-radius: 1px;
    box-shadow: 0 0 10px var(--glow-emerald);
}

h2 {
    font-size: var(--font-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: var(--space-xxl) 0 var(--space-lg);
    color: var(--accent-gold);
    position: relative;
    padding-bottom: var(--space-md);
}

h2::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -4px;
    width: 4px;
    height: calc(100% + 4px);
    background: var(--accent-gradient);
    border-radius: 2px;
    opacity: 0.6;
}

h3 {
    font-size: var(--font-sm);
    font-weight: 500;
    margin: var(--space-xl) 0 var(--space-md);
    color: var(--accent-emerald);
    letter-spacing: -0.005em;
}

/* 📖 REFINED TEXT ELEMENTS 📖 */
p {
    margin-bottom: var(--space-lg);
    color: var(--text-secondary);
    line-height: var(--golden-ratio);
}

p:first-of-type {
    font-size: calc(var(--font-sm) * 1.1);
    color: var(--text-primary);
    font-weight: 450;
}

/* 🎨 VIRTUOSO INTERACTIVE ELEMENTS 🎨 */
.calculator-card {
    background: linear-gradient(145deg, var(--surface) 0%, var(--surface-light) 100%);
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
    margin: var(--space-xl) 0;
    box-shadow:
        0 8px 32px var(--shadow-medium),
        0 2px 8px var(--shadow-soft),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.calculator-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-gradient);
    opacity: 0.3;
}

.calculator-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow:
        0 12px 48px var(--shadow-deep),
        0 4px 16px var(--shadow-medium),
        0 0 20px var(--glow-emerald);
}

/* 🔘 MASTERPIECE FORM ELEMENTS 🔘 */
.form-group {
    margin-bottom: var(--space-lg);
    position: relative;
}

label {
    display: block;
    margin-bottom: var(--space-sm);
    font-weight: 500;
    color: var(--text-primary);
    font-size: var(--font-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

input, select, textarea {
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    background: rgba(0, 0, 0, 0.2);
    border: 2px solid var(--border);
    border-radius: var(--border-radius);
    color: var(--text-primary);
    font-size: var(--font-sm);
    font-weight: 450;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    backdrop-filter: blur(10px);
}

input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow:
        0 0 0 3px var(--glow-gold),
        0 4px 16px var(--shadow-medium);
    transform: scale(1.01);
}

/* 🎯 VIRTUOSO BUTTON MASTERY 🎯 */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-xl);
    background: var(--accent-gradient);
    color: var(--primary);
    font-weight: 600;
    font-size: var(--font-sm);
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: var(--font-xs);
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.2) 50%, transparent 100%);
    transition: left 0.6s;
}

.btn:hover {
    transform: translateY(-1px) scale(1.02);
    box-shadow:
        0 8px 24px rgba(212, 175, 55, 0.3),
        0 2px 8px var(--shadow-medium);
}

.btn:hover::before {
    left: 100%;
}

.btn:active {
    transform: translateY(0) scale(0.98);
}

/* 📊 VIRTUOSO DATA VISUALIZATION 📊 */
.results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
}

.result-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.result-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent-gradient);
}

.result-value {
    font-size: var(--font-md);
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: var(--space-sm);
}

.result-label {
    font-size: var(--font-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* 📱 RESPONSIVE MASTERY 📱 */
@media (max-width: 768px) {
    .container {
        padding: var(--space-lg) var(--space-md);
    }

    .results-grid {
        grid-template-columns: 1fr;
        gap: var(--space-md);
    }

    h1 {
        font-size: var(--font-lg);
    }
}

/* ✨ VIRTUOSO ANIMATIONS ✨ */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

.fade-in {
    animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.pulse {
    animation: pulse 2s ease-in-out infinite;
}

/* 🎨 MASTERPIECE FINISHING TOUCHES 🎨 */
::selection {
    background: var(--accent-gold);
    color: var(--primary);
}

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--primary);
}

::-webkit-scrollbar-thumb {
    background: var(--accent-gradient);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--accent-gold);
}

/* 🏆 VIRTUOSO EXCELLENCE COMPLETE 🏆 */

/* 🎨 VIRTUOSO ADVANCED AESTHETIC ENHANCEMENTS 🎨 */
/* Museum-Quality Visual Refinements with Master Painter Precision */

/* ✨ ADVANCED MICRO-ANIMATIONS ✨ */
@keyframes breathe {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.02) rotate(0.5deg); }
}

@keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes etherealGlow {
    0%, 100% {
        box-shadow: 0 0 20px rgba(212, 175, 55, 0.1),
                    0 0 40px rgba(0, 212, 170, 0.05);
    }
    50% {
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.2),
                    0 0 60px rgba(0, 212, 170, 0.1);
    }
}

/* 🏛️ MASTERPIECE CONTAINER ENHANCEMENTS 🏛️ */
.container {
    position: relative;
}

.container::before {
    animation: etherealGlow 4s ease-in-out infinite;
}

.container::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
        linear-gradient(45deg, transparent 30%, rgba(212, 175, 55, 0.005) 50%, transparent 70%),
        linear-gradient(-45deg, transparent 30%, rgba(0, 212, 170, 0.003) 50%, transparent 70%);
    pointer-events: none;
    z-index: -1;
    animation: float 20s ease-in-out infinite;
}

/* 🎭 ENHANCED TYPOGRAPHY WITH ARTISTIC FLAIR 🎭 */
h1 {
    position: relative;
    overflow: hidden;
}

h1::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.1) 50%,
        transparent 100%
    );
    animation: shimmer 3s ease-in-out infinite;
}

h2 {
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

h2:hover {
    transform: translateX(8px);
    color: var(--accent-emerald);
    text-shadow: 0 0 20px rgba(0, 212, 170, 0.3);
}

/* 🎨 ADVANCED CALCULATOR CARD MASTERY 🎨 */
.calculator-card {
    position: relative;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.calculator-card::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    z-index: 1;
}

.calculator-card:hover::after {
    width: 300px;
    height: 300px;
}

.calculator-card > * {
    position: relative;
    z-index: 2;
}

/* 🔘 MUSEUM-QUALITY FORM ELEMENTS 🔘 */
.form-group {
    position: relative;
    overflow: hidden;
}

.form-group::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: -100%;
    width: 100%;
    height: 2px;
    background: var(--accent-gradient);
    transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 1;
}

.form-group:focus-within::before {
    left: 0;
}

input, select, textarea {
    position: relative;
    z-index: 2;
    background: rgba(42, 26, 74, 0.8);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

input::placeholder, select::placeholder, textarea::placeholder {
    color: var(--text-muted);
    font-style: italic;
    transition: all 0.3s ease;
}

input:focus::placeholder {
    opacity: 0.5;
    transform: translateY(-20px);
}

/* 🌟 ENHANCED BUTTON ARTISTRY 🌟 */
.btn {
    position: relative;
    background: var(--accent-gradient);
    background-size: 200% 200%;
    animation: breathe 4s ease-in-out infinite;
}

.btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.btn:active::after {
    width: 100px;
    height: 100px;
}

/* 📊 ADVANCED DATA VISUALIZATION MASTERY 📊 */
.results-grid {
    perspective: 1000px;
}

.result-card {
    transform-style: preserve-3d;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background: linear-gradient(145deg,
        rgba(42, 26, 74, 0.9) 0%,
        rgba(61, 41, 97, 0.8) 100%);
    backdrop-filter: blur(15px);
}

.result-card:hover {
    transform: rotateY(5deg) rotateX(5deg) translateZ(20px);
    box-shadow:
        0 20px 40px rgba(26, 13, 51, 0.4),
        0 0 30px rgba(212, 175, 55, 0.1);
}

.result-card::before {
    background: var(--accent-gradient);
    height: 4px;
    border-radius: 2px;
}

.result-value {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 2s ease-in-out infinite;
    background-size: 200% 200%;
}

/* 🎪 ADVANCED INTERACTION STATES 🎪 */
.interactive-element {
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.interactive-element::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg,
        rgba(212, 175, 55, 0.05) 0%,
        transparent 25%,
        transparent 75%,
        rgba(0, 212, 170, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: inherit;
}

.interactive-element:hover::before {
    opacity: 1;
}

/* 🏆 MASTERPIECE SCROLL ENHANCEMENTS 🏆 */
* {
    scroll-behavior: smooth;
}

body {
    overflow-x: hidden;
}

/* Custom scrollbar with artistic flair */
::-webkit-scrollbar {
    width: 12px;
}

::-webkit-scrollbar-track {
    background: var(--primary);
    border-radius: 6px;
}

::-webkit-scrollbar-thumb {
    background: var(--accent-gradient);
    border-radius: 6px;
    border: 2px solid var(--primary);
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #d4af37 0%, #00d4aa 100%);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
}

/* ✨ AESTHETIC LOADING STATES ✨ */
.loading-shimmer {
    background: linear-gradient(
        90deg,
        rgba(42, 26, 74, 0.8) 25%,
        rgba(61, 41, 97, 0.6) 50%,
        rgba(42, 26, 74, 0.8) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
}

/* 🎨 ADVANCED SELECTION STYLING 🎨 */
::selection {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.8) 0%, rgba(0, 212, 170, 0.6) 100%);
    color: var(--primary);
    text-shadow: none;
}

::-moz-selection {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.8) 0%, rgba(0, 212, 170, 0.6) 100%);
    color: var(--primary);
    text-shadow: none;
}

/* 🌙 ADVANCED FOCUS STATES 🌙 */
*:focus {
    outline: 2px solid transparent;
    outline-offset: 4px;
}

*:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 4px;
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
}

/* 📱 PREMIUM MOBILE EXPERIENCE 📱 */
@media (max-width: 768px) {
    .container::after {
        animation-duration: 30s;
    }

    .calculator-card {
        backdrop-filter: blur(15px);
    }

    .result-card:hover {
        transform: scale(1.02);
    }

    .btn {
        animation: none;
    }
}

/* 🎪 ACCESSIBILITY WITH STYLE 🎪 */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* 🏆 VIRTUOSO EXCELLENCE SIGNATURE 🏆 */
.virtuoso-signature::after {
    content: '🎨 Virtuoso Excellence';
    position: fixed;
    bottom: 20px;
    right: 20px;
    font-size: 10px;
    color: var(--text-muted);
    opacity: 0.5;
    font-weight: 300;
    letter-spacing: 1px;
    z-index: 1000;
    pointer-events: none;
}

/* ✨ FINAL MASTERPIECE TOUCHES ✨ */
